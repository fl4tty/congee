<Project Sdk="Microsoft.NET.Sdk">

  <!-- congee-sensors: a small Windows service that reads temperatures, fans and GPU stats with
       LibreHardwareMonitorLib and serves them on 127.0.0.1:8086 in LibreHardwareMonitor's own
       data.json format, so congee (either edition) reads it without running as administrator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>congee-sensors</AssemblyName>
    <RootNamespace>CongeeSensors</RootNamespace>
    <ApplicationIcon>..\congee.ico</ApplicationIcon>
    <Version>1.2.4</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Background service: favour a small, steady footprint over GC throughput -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
