<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>congee</AssemblyName>
    <RootNamespace>Congee</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\congee.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.2.3</Version>
    <!-- Always-on widget: favour a small, steady footprint over GC throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same default config/template as the Python version -->
    <None Include="..\congee.conf" Link="congee.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
